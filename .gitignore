# Python environment
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Generated CAD artifacts: STEP/STL/previews/reports ARE tracked (committed
# on request, so the repo always has a browsable, up-to-date snapshot of
# the built models). Only the per-run build logs are ignored (timestamped,
# not meaningful to diff/version).
output/logs/*
!output/logs/.gitkeep

output/rifle-mount/logs/*
!output/rifle-mount/logs/.gitkeep

# Local Claude Code settings (machine-specific permissions) and runtime state
.claude/settings.local.json
.claude/settings.local.json.tmp*
.claude/scheduled_tasks.lock
